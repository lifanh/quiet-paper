{
  "name": "@lifanh/quiet-paper",
  "version": "0.2.2",
  "description": "Quiet paper design system — Tailwind v4 tokens, React primitives, and prose styling",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lifanh/quiet-paper.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && node scripts/build-tokens.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/quiet-paper.js",
      "default": "./dist/quiet-paper.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json",
    "./styles/tokens.css": "./styles/tokens.css",
    "./styles/tailwind-theme.css": "./styles/tailwind-theme.css",
    "./styles/tailwind-sources.css": "./styles/tailwind-sources.css",
    "./styles/prose.css": "./styles/prose.css"
  },
  "files": [
    "dist",
    "styles",
    "README.md"
  ],
  "peerDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vite-plugin-dts": "^5.0.3"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0"
  }
}
